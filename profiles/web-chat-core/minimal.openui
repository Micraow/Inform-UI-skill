$minimum = 60
rows = [{name:"读书会",score:91},{name:"写作课",score:76},{name:"分享会",score:67},{name:"讨论班",score:54}]
visible = @Sort(@Filter(rows,"score",">=",$minimum),"score","desc")
root = Stack([
 Heading("让图表、表格和解释一起更新",1),
 Text("这组原创示例中，读书会反馈分最高，为 91 分。调整最低分，可以观察候选活动怎样变化；图表和表格始终使用同一份筛选结果。","muted"),
 Card([Slider("最低反馈分",$minimum,0,100,1),Button("恢复 60 分",@Reset($minimum),"secondary")],"试着筛选"),
 Text("达到阈值："+@Count(visible)+" 场活动"),
 @Count(visible)>0 ? Stack([
  Text("候选活动的等权平均反馈分："+@Round(@Avg(visible.score),1)+" 分。"),
  BarChart("候选活动反馈分",visible.name,[Series("反馈分",visible.score)],{height:280,animate:false}),
  Table([{key:"name",label:"活动"},{key:"score",label:"反馈分"}],visible,"与图表相同的数据")
 ],"lg") : Alert("当前没有匹配结果","把最低分调到 91 或以下，或使用恢复按钮。","warning"),
 Text("反馈分不能单独决定活动是否适合你。还要核对主题、时间与费用。这里没有提供这些资料，所有活动与分数都是演示数据。"),
 Text("来源：本例原创四行数据。筛选按 score ≥ 最低分；平均分按活动等权计算。","muted")
],"xl")
