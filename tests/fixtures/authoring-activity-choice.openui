root = Stack([intro,controls,summary,results,selection,guide,sourceNote],"xl")
$minimum = 0
$direction = "desc"
$chosen = ""
rows = [{id:"reading",name:"读书会",participants:18,score:91},{id:"writing",name:"写作课",participants:20,score:76},{id:"sharing",name:"分享会",participants:32,score:67},{id:"discussion",name:"讨论班",participants:16,score:54}]
visible = @Sort(@Filter(rows,"score",">=",$minimum),"participants",$direction)
picked = @First(@Filter(rows,"id","==",$chosen))
intro = Stack([Badge("四场虚构活动 · 示例数据"),Heading("先确定偏好，再挑选活动",1),Text("如果优先看这组示例中的反馈分数，读书会值得优先考虑：91 分是四场中最高的，参与人数为 18 人。如果更想参加人数较多的活动，分享会有 32 人，但其反馈分数是 67 分。先设定可接受的最低反馈分数，再按人数比较，会比把两个数字混成一个排名更清楚。"),Text("活动主题、时间、费用和个人兴趣还没有提供，所以这些数据只能帮助缩小范围，不能确定对每个人都适用的最佳活动。","muted")],"md")
controls = Card([Slider("最低反馈分数（分）",$minimum,0,100,1),Select("按参与人数排序",$direction,[{label:"人数从多到少",value:"desc"},{label:"人数从少到多",value:"asc"}]),Text("当前最低分："+$minimum+" 分；排序："+($direction=="desc" ? "人数从多到少" : "人数从少到多")),Button("恢复全部活动并清空选择",@Reset($minimum,$direction,$chosen),"secondary")],"1. 调整筛选与顺序")
summary = Row([Badge("符合条件："+@Count(visible)+" 场"),Badge("参与人数合计："+@Sum(visible.participants)+" 人次")],"md")
results = @Count(visible)>0 ? Stack([Heading("2. 比较当前候选",2),Text("当前候选的活动等权平均反馈分数："+@Round(@Avg(visible.score),1)+" 分。这里每场活动权重相同，不是所有参与者的平均评分。"),BarChart("反馈分数：只比较分数",visible.name,[Series("反馈分数",visible.score)],{height:280,animate:false,yAxisLabel:"反馈分数（分）"}),BarChart("参与人数：只比较活动规模",visible.name,[Series("参与人数",visible.participants)],{height:280,animate:false,yAxisLabel:"参与人数（人）"}),Table([{key:"name",label:"活动"},{key:"participants",label:"参与人数（人）"},{key:"score",label:"反馈分数（分）"}],@Each(visible,"activity",{name:activity.name,participants:activity.participants,score:activity.score}),"与图表同步的候选列表：最低分筛选后，按人数排序"),Stack(@Each(visible,"activity",Card([Text("参与 "+activity.participants+" 人；反馈 "+activity.score+" 分。"),Button($chosen==activity.id ? "已选："+activity.name : "选择："+activity.name,@Set($chosen,activity.id),"secondary")],activity.name)),"md")],"lg") : Alert("没有符合条件的活动","当前最低分超过了全部示例活动的分数。把最低分调到 91 分或以下，或点击恢复按钮。没有候选时不显示平均分，也不绘制空图。","warning")
selection = Card([$chosen=="" ? Text("尚未选择。点击候选活动下的选择按钮，就能在这里看到结果。") : Stack([Text("当前选择："+picked.name),Text("参与 "+picked.participants+" 人；反馈 "+picked.score+" 分。"),picked.score<$minimum ? Alert("当前选择已不满足筛选条件","原选择暂时保留。请从当前候选重新选择，或降低最低分，或清空选择。","warning") : Text("该活动满足当前最低分要求。","success"),Button("清空选择",@Reset($chosen),"ghost")],"md"),Text("选择仅记录在当前页面中，用于比较；不会报名、付款或联系活动方。","muted")],"3. 查看你的选择")
guide = Stack([Heading("如何理解这两个指标",2),Text("反馈分数描述这组示例提供的评价结果；参与人数描述活动规模。它们单位不同，不能直接相加，也不能把人数更多解释为评价更好。参与人数并不等于实际填写反馈的人数，这里也没有提供评分方法或反馈样本量。"),Text("读书会：18 人、91 分，适合优先看反馈分数时先考察。写作课：20 人、76 分，可在主题符合兴趣时纳入比较。分享会：32 人、67 分，人数最多，但不能据此断言内容质量更高。讨论班：16 人、54 分，人数最少、反馈分数也最低；人数少本身不能证明互动更充分。"),Text("可以试着把最低分设为 70：留下读书会和写作课。再把人数排序切为从少到多，读书会在前，写作课在后。切换排序只改变展示次序；提高最低分会改变候选集合，因此图表、表格和统计值都会更新。"),Text("下决定前，再核实主题、时间、费用与实际反馈来源。如果人数规模也重要，先规定可接受的反馈门槛，再在剩余活动中选择规模更合心意的一个。")],"md")
sourceNote = Text("数据来源：本题给出的四场虚构活动，仅作原创示例演示，不代表真实活动、调查或推荐。为方便演示，筛选控件范围设为 0–100 分。人数合计是各场参与人数之和，以人次表示，未去重。反馈平均分按活动等权计算。","muted")
