{
  "version": "iui/1",
  "state": {
    "attendees": 12
  },
  "computed": {
    "remaining": {
      "op": "sub",
      "args": [
        30,
        {
          "$": "attendees"
        }
      ]
    }
  },
  "body": [
    {
      "type": "text",
      "value": "活动名额 · 原创合成示例"
    },
    {
      "type": "form",
      "label": "活动名额",
      "children": [
        {
          "type": "slider",
          "label": "参加人数",
          "bind": "attendees",
          "min": 0,
          "max": 30,
          "step": 1
        },
        {
          "type": "metric",
          "label": "剩余名额",
          "value": {
            "$": "remaining"
          },
          "unit": "个"
        },
        {
          "type": "text",
          "value": "共 30 个名额。仅在本地计算，不提交报名。"
        }
      ]
    }
  ]
}
