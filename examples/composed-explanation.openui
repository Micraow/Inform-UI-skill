$largest = 12
$showMethod = true
numbers = [4,6,8,$largest]
mean = @Avg(numbers)
median = (numbers[1]+numbers[2])/2
root = Stack([
 Badge("交互式概念解释"),
 Heading("为什么一个大数会拉高平均数？",1),
 Text("平均数把所有值都放进总和。中位数只看排序后的中间位置。把最后一个数从 12 调高，你会看到平均数上升，而这组数据的中位数一直是 7。","muted"),
 Card([Slider("第四个数",$largest,8,80,2),Switch("展开计算过程",$showMethod),Button("恢复为 12",@Reset($largest),"secondary")],"自己试一次"),
 Grid([MetricView({label:"平均数",value:@Round(mean,1)}),MetricView({label:"中位数",value:median}),MetricView({label:"第四个数",value:$largest})],3,"lg"),
 FigureView({caption:"四个原创示例数字。只改变第四项，前三项始终为 4、6、8。"},[BarChart("四个数的大小",["第一项","第二项","第三项","第四项"],[Series("数值",numbers)],{height:280,animate:false})]),
 $showMethod ? SectionView({heading:"从数字到结论"},[
  StepsView({items:[{title:"求和",detail:"4 + 6 + 8 + "+$largest+" = "+@Sum(numbers)},{title:"计算平均数",detail:@Sum(numbers)+" ÷ 4 = "+mean},{title:"找中间位置",detail:"已经按升序排列。中间两个数为 6 与 8，所以中位数为 (6 + 8) ÷ 2 = 7。"}]}),
  MathView({latex:"\\bar{x}=\\frac{1}{n}\\sum_{i=1}^{n}x_i",block:true})
 ]) : Text("计算过程已收起；图表与统计值仍会随滑块更新。","muted"),
 Heading("该用哪个指标？",2),
 Text("如果问题关心总量被平均分配的结果，平均数很直接。如果想描述一组数据的中间位置，又不想让单个极端值产生很大影响，中位数往往更有帮助。先明确问题，再选择统计量。"),
 DetailsView({summary:"这个演示的边界"},[Text("第四个数的最小值为 8，数据始终有序，中间两项不会改变。这说明的是这一组四个数的行为；别推广成任何数据变化都不会影响中位数。")]),
 CitationView({number:1,title:"NIST：Measures of Location",url:"https://www.itl.nist.gov/div898/handbook/eda/section3/eda351.htm",publisher:"NIST/SEMATECH e-Handbook",description:"平均数、中位数及极端值影响的定义与解释。图表数据由本示例原创，不来自 NIST。"})
],"xl")
