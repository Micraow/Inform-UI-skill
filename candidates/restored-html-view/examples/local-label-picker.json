{
  "version": "iui/1",
  "title": "Original offline authored HTML",
  "body": [
    {
      "type": "html-view",
      "id": "local-picker",
      "title": "Local supplied label picker",
      "width": "100%",
      "height": 260,
      "html": "<style>body{font:16px/1.5 system-ui;margin:16px}button{font:inherit;margin-right:8px}output{display:block;margin-top:12px}</style>\n<h2>Two supplied labels</h2><p>This local document alternates two fictional labels. Nothing is sent.</p>\n<button id=\"choose\" type=\"button\">Choose next label</button><button id=\"clear\" type=\"button\" onclick=\"document.querySelector('#result').textContent='No local choice'\">Clear local choice</button>\n<output id=\"result\" aria-live=\"polite\">No local choice</output>\n<script>\nconst labels = ['Cedar', 'Linen'];\nlet index = 0;\ndocument.querySelector('#choose').addEventListener('click', () => {\n  document.querySelector('#result').textContent = labels[index % labels.length];\n  index += 1;\n});\ndocument.body.dataset.localReady = 'true';\n</script>"
    }
  ]
}
