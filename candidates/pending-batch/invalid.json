          "blanks": [
            {
              "id": "a",
              "label": "Answer",
              "answers": [
                "yes",
                " yes "
              ]
            }
          ]
        }
      ]
    },
    "expectedCode": "FILL_BLANK_ANSWER",
    "expectedPath": "/body/0/blanks/0/answers/1"
  },
