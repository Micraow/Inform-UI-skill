{
  "version": "iui/1",
  "title": "房间座椅安排",
  "body": [
    {
      "type": "questionnaire",
      "questionnaireId": "room_seating",
      "version": "1.0.0",
      "title": "座椅安排",
      "hiddenValuePolicy": "retain",
      "fields": [
        {"id": "nickname", "label": "昵称", "type": "text", "required": false, "maxLength": 20},
        {"id": "people", "label": "人数", "type": "number", "required": true, "min": 0, "max": 50, "step": 1},
        {
          "id": "chairs",
          "label": "座椅数",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 60,
          "step": 1,
          "validWhen": {
            "op": "if",
            "args": [
              {"op": "lt", "args": [{"$": "chairs"}, {"$": "people"}]},
              false,
              true
            ]
          },
          "validationMessage": "座椅数不能少于人数。"
        }
      ],
      "initialAnswers": {"nickname": null, "people": null, "chairs": 4},
      "defaults": {"nickname": null, "people": null, "chairs": 4},
      "computed": {"freeChairs": {"op": "sub", "args": [{"$": "chairs"}, {"$": "people"}]}},
      "sources": [{"title": "原创非医疗软件验收规则", "version": "1.0.0"}]
    }
  ]
}
