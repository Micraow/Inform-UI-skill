{
  "version": "iui/1",
  "title": "灯笼供电",
  "body": [
    {
      "type": "questionnaire",
      "questionnaireId": "lantern_power",
      "version": "1.0.0",
      "title": "供电方式",
      "hiddenValuePolicy": "clear",
      "fields": [
        {
          "id": "power",
          "label": "电源",
          "type": "choice",
          "required": true,
          "options": [{"value": "battery", "label": "电池"}, {"value": "wired", "label": "插电"}]
        },
        {
          "id": "cells",
          "label": "电池数",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 6,
          "step": 1,
          "visibleWhen": {"op": "eq", "args": [{"$": "power"}, "battery"]}
        }
      ],
      "initialAnswers": {"power": "battery", "cells": 2},
      "defaults": {"power": "battery", "cells": 2},
      "computed": {
        "powerUnits": {
          "op": "if",
          "args": [
            {"op": "eq", "args": [{"$": "power"}, "battery"]},
            {"op": "mul", "args": [{"$": "cells"}, 3]},
            12
          ]
        }
      },
      "sources": [{"title": "原创非医疗软件验收规则", "version": "1.0.0"}]
    }
  ]
}
