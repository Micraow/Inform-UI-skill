{
  "version": "iui/1",
  "title": "志愿服务时长",
  "body": [
    {
      "type": "questionnaire",
      "questionnaireId": "volunteer_hours",
      "version": "1.0.0",
      "title": "服务时长",
      "hiddenValuePolicy": "retain",
      "fields": [
        {"id": "hours", "label": "已确认时长（小时）", "type": "number", "required": true, "min": 0, "max": 24, "step": 0.5},
        {"id": "extra", "label": "额外时长（小时）", "type": "number", "required": false, "min": 0, "max": 8, "step": 0.5}
      ],
      "initialAnswers": {"hours": 2, "extra": null},
      "defaults": {"hours": 2, "extra": null},
      "computed": {
        "confirmedHours": {"$": "hours"},
        "totalHours": {
          "op": "if",
          "args": [
            {"op": "eq", "args": [{"$": "extra"}, null]},
            null,
            {"op": "add", "args": [{"$": "hours"}, {"$": "extra"}]}
          ]
        }
      },
      "sources": [{"title": "原创非医疗软件验收规则", "version": "1.0.0"}]
    }
  ]
}
