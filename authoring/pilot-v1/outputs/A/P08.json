{
  "version": "iui/1",
  "title": "设备审阅",
  "body": [
    {
      "type": "questionnaire",
      "questionnaireId": "equipment_review",
      "version": "1.0.0",
      "title": "设备审阅",
      "hiddenValuePolicy": "retain",
      "fields": [
        {
          "id": "needsCable",
          "label": "是否需要线缆",
          "type": "boolean",
          "required": true
        },
        {
          "id": "cableChecked",
          "label": "线缆是否检查",
          "type": "boolean",
          "required": true,
          "visibleWhen": {
            "op": "eq",
            "args": [
              {
                "$": "needsCable"
              },
              true
            ]
          }
        },
        {
          "id": "kits",
          "label": "套件数量",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 5,
          "step": 1
        }
      ],
      "computed": {
        "readyKits": {
          "op": "mul",
          "args": [
            {
              "$": "kits"
            },
            2
          ]
        }
      },
      "initialAnswers": {
        "needsCable": false,
        "cableChecked": null,
        "kits": 2
      },
      "defaults": {
        "needsCable": false,
        "cableChecked": null,
        "kits": 2
      },
      "sources": [
        {
          "title": "原创非医疗软件验收规则",
          "version": "1.0.0"
        }
      ],
      "action": "reviewEquipment",
      "submitLabel": "本地审阅",
      "resetLabel": "恢复问卷"
    }
  ]
}
