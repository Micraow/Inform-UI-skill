{
  "version": "iui/1",
  "title": "展板尺寸",
  "body": [
    {
      "type": "questionnaire",
      "questionnaireId": "display_panels",
      "version": "1.0.0",
      "title": "展板尺寸",
      "hiddenValuePolicy": "retain",
      "fields": [
        {
          "id": "panels",
          "label": "展板数量",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 20,
          "step": 1
        },
        {
          "id": "widthM",
          "label": "单块宽度（米）",
          "type": "number",
          "required": true,
          "min": 0.5,
          "max": 4,
          "step": 0.5
        }
      ],
      "computed": {
        "spanM": {
          "op": "mul",
          "args": [
            {
              "$": "panels"
            },
            {
              "$": "widthM"
            }
          ]
        },
        "doubleSpanM": {
          "op": "mul",
          "args": [
            {
              "$": "spanM"
            },
            2
          ]
        }
      },
      "initialAnswers": {
        "panels": 4,
        "widthM": 1.5
      },
      "defaults": {
        "panels": 4,
        "widthM": 1.5
      },
      "sources": [
        {
          "title": "原创非医疗软件验收规则",
          "version": "1.0.0"
        }
      ]
    }
  ]
}
