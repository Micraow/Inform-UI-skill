{
  "version": "iui/1",
  "title": "包裹领取",
  "body": [
    {
      "type": "questionnaire",
      "questionnaireId": "parcel_route",
      "version": "1.0.0",
      "title": "包裹领取",
      "hiddenValuePolicy": "retain",
      "fields": [
        {
          "id": "route",
          "label": "领取方式",
          "type": "choice",
          "required": true,
          "options": [
            {
              "value": "pickup",
              "label": "自取"
            },
            {
              "value": "delivery",
              "label": "配送"
            }
          ]
        },
        {
          "id": "parcels",
          "label": "包裹数量",
          "type": "number",
          "required": true,
          "min": 1,
          "max": 10,
          "step": 1
        },
        {
          "id": "distanceKm",
          "label": "配送距离（公里）",
          "type": "number",
          "required": true,
          "min": 0,
          "max": 100,
          "step": 0.5,
          "visibleWhen": {
            "op": "eq",
            "args": [
              {
                "$": "route"
              },
              "delivery"
            ]
          }
        }
      ],
      "computed": {
        "chargeUnits": {
          "op": "add",
          "args": [
            {
              "op": "mul",
              "args": [
                {
                  "$": "parcels"
                },
                4
              ]
            },
            {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "route"
                    },
                    "delivery"
                  ]
                },
                {
                  "op": "mul",
                  "args": [
                    {
                      "$": "distanceKm"
                    },
                    2
                  ]
                },
                0
              ]
            }
          ]
        }
      },
      "initialAnswers": {
        "route": "pickup",
        "parcels": 2,
        "distanceKm": null
      },
      "defaults": {
        "route": "pickup",
        "parcels": 2,
        "distanceKm": null
      },
      "sources": [
        {
          "title": "原创非医疗软件验收规则",
          "version": "1.0.0"
        }
      ]
    }
  ]
}
