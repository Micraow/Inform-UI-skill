[
  {
    "id": "P01",
    "document": {
      "version": "iui/1",
      "body": [
        {
          "type": "questionnaire",
          "questionnaireId": "stationery_batches",
          "version": "1.0.0",
          "title": "stationery_batches",
          "hiddenValuePolicy": "retain",
          "fields": [
            {
              "id": "batches",
              "label": "batches",
              "type": "number",
              "required": true,
              "min": 0,
              "max": 12,
              "step": 1
            },
            {
              "id": "units",
              "label": "units",
              "type": "number",
              "required": true,
              "min": 0,
              "max": 8,
              "step": 1
            },
            {
              "id": "reused",
              "label": "reused",
              "type": "boolean",
              "required": true
            }
          ],
          "initialAnswers": {
            "batches": 3,
            "units": 0,
            "reused": false
          },
          "defaults": {
            "batches": 3,
            "units": 0,
            "reused": false
          },
          "computed": {
            "itemCount": {
              "op": "mul",
              "args": [
                {
                  "$": "batches"
                },
                {
                  "$": "units"
                }
              ]
            }
          },
          "sources": [
            {
              "title": "原创非医疗软件验收规则",
              "version": "1.0.0"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "P02",
    "document": {
      "version": "iui/1",
      "body": [
        {
          "type": "questionnaire",
          "questionnaireId": "volunteer_hours",
          "version": "1.0.0",
          "title": "volunteer_hours",
          "hiddenValuePolicy": "retain",
          "fields": [
            {
              "id": "hours",
              "label": "hours",
              "type": "number",
              "required": true,
              "min": 0,
              "max": 24,
              "step": 0.5
            },
            {
              "id": "extra",
              "label": "extra",
              "type": "number",
              "required": false,
              "min": 0,
              "max": 8,
              "step": 0.5
            }
          ],
          "initialAnswers": {
            "hours": 2,
            "extra": null
          },
          "defaults": {
            "hours": 2,
            "extra": null
          },
          "computed": {
            "confirmedHours": {
              "$": "hours"
            },
            "totalHours": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "extra"
                    },
                    null
                  ]
                },
                null,
                {
                  "op": "add",
                  "args": [
                    {
                      "$": "hours"
                    },
                    {
                      "$": "extra"
                    }
                  ]
                }
              ]
            }
          },
          "sources": [
            {
              "title": "原创非医疗软件验收规则",
              "version": "1.0.0"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "P03",
    "document": {
      "version": "iui/1",
      "body": [
        {
          "type": "questionnaire",
          "questionnaireId": "parcel_route",
          "version": "1.0.0",
          "title": "parcel_route",
          "hiddenValuePolicy": "retain",
          "fields": [
            {
              "id": "route",
              "label": "route",
              "type": "choice",
              "required": true,
              "options": [
                {
                  "value": "pickup",
                  "label": "自取"
                },
                {
                  "value": "delivery",
                  "label": "配送"
                }
              ]
            },
            {
              "id": "parcels",
              "label": "parcels",
              "type": "number",
              "required": true,
              "min": 1,
              "max": 10,
              "step": 1
            },
            {
              "id": "distanceKm",
              "label": "distanceKm",
              "type": "number",
              "required": true,
              "min": 0,
              "max": 100,
              "step": 0.5,
              "visibleWhen": {
                "op": "eq",
                "args": [
                  {
                    "$": "route"
                  },
                  "delivery"
                ]
              }
            }
          ],
          "initialAnswers": {
            "route": "pickup",
            "parcels": 2,
            "distanceKm": null
          },
          "defaults": {
            "route": "pickup",
            "parcels": 2,
            "distanceKm": null
          },
          "computed": {
            "chargeUnits": {
              "op": "add",
              "args": [
                {
                  "op": "mul",
                  "args": [
                    {
                      "$": "parcels"
                    },
                    4
                  ]
                },
                {
                  "op": "if",
                  "args": [
                    {
                      "op": "eq",
                      "args": [
                        {
                          "$": "route"
                        },
                        "delivery"
                      ]
                    },
                    {
                      "op": "mul",
                      "args": [
                        {
                          "$": "distanceKm"
                        },
                        2
                      ]
                    },
                    0
                  ]
                }
              ]
            }
          },
          "sources": [
            {
              "title": "原创非医疗软件验收规则",
              "version": "1.0.0"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "P04",
    "document": {
      "version": "iui/1",
      "body": [
        {
          "type": "questionnaire",
          "questionnaireId": "lantern_power",
          "version": "1.0.0",
          "title": "lantern_power",
          "hiddenValuePolicy": "clear",
          "fields": [
            {
              "id": "power",
              "label": "power",
              "type": "choice",
              "required": true,
              "options": [
                {
                  "value": "battery",
                  "label": "电池"
                },
                {
                  "value": "wired",
                  "label": "插电"
                }
              ]
            },
            {
              "id": "cells",
              "label": "cells",
              "type": "number",
              "required": true,
              "min": 1,
              "max": 6,
              "step": 1,
              "visibleWhen": {
                "op": "eq",
                "args": [
                  {
                    "$": "power"
                  },
                  "battery"
                ]
              }
            }
          ],
          "initialAnswers": {
            "power": "battery",
            "cells": 2
          },
          "defaults": {
            "power": "battery",
            "cells": 2
          },
          "computed": {
            "powerUnits": {
              "op": "if",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    {
                      "$": "power"
                    },
                    "battery"
                  ]
                },
                {
                  "op": "mul",
                  "args": [
                    {
                      "$": "cells"
                    },
                    3
                  ]
                },
                12
              ]
            }
          },
          "sources": [
            {
              "title": "原创非医疗软件验收规则",
              "version": "1.0.0"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "P05",
    "document": {
      "version": "iui/1",
      "body": [
        {
          "type": "questionnaire",
          "questionnaireId": "room_seating",
          "version": "1.0.0",
          "title": "room_seating",
          "hiddenValuePolicy": "retain",
          "fields": [
            {
              "id": "nickname",
              "label": "昵称",
              "type": "text",
              "maxLength": 20
            },
            {
              "id": "people",
              "label": "people",
              "type": "number",
              "required": true,
              "min": 0,
              "max": 50,
              "step": 1
            },
            {
              "id": "chairs",
              "label": "chairs",
              "type": "number",
              "required": true,
              "min": 0,
              "max": 60,
              "step": 1,
              "validWhen": {
                "op": "if",
                "args": [
                  {
                    "op": "lt",
                    "args": [
                      {
                        "$": "chairs"
                      },
                      {
                        "$": "people"
                      }
                    ]
                  },
                  false,
                  true
                ]
              },
              "validationMessage": "椅子不能少于人数"
            }
          ],
          "initialAnswers": {
            "nickname": null,
            "people": null,
            "chairs": 4
          },
          "defaults": {
            "nickname": null,
            "people": null,
            "chairs": 4
          },
          "computed": {
            "freeChairs": {
              "op": "sub",
              "args": [
                {
                  "$": "chairs"
                },
                {
                  "$": "people"
                }
              ]
            }
          },
          "sources": [
            {
              "title": "原创非医疗软件验收规则",
              "version": "1.0.0"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "P06",
    "document": {
      "version": "iui/1",
      "body": [
        {
          "type": "questionnaire",
          "questionnaireId": "display_panels",
          "version": "1.0.0",
          "title": "display_panels",
          "hiddenValuePolicy": "retain",
          "fields": [
            {
              "id": "panels",
              "label": "panels",
              "type": "number",
              "required": true,
              "min": 1,
              "max": 20,
              "step": 1
            },
            {
              "id": "widthM",
              "label": "widthM",
              "type": "number",
              "required": true,
              "min": 0.5,
              "max": 4,
              "step": 0.5
            }
          ],
          "initialAnswers": {
            "panels": 4,
            "widthM": 1.5
          },
          "defaults": {
            "panels": 4,
            "widthM": 1.5
          },
          "computed": {
            "spanM": {
              "op": "mul",
              "args": [
                {
                  "$": "panels"
                },
                {
                  "$": "widthM"
                }
              ]
            },
            "doubleSpanM": {
              "op": "mul",
              "args": [
                {
                  "$": "spanM"
                },
                2
              ]
            }
          },
          "sources": [
            {
              "title": "原创非医疗软件验收规则",
              "version": "1.0.0"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "P07",
    "document": {
      "version": "iui/1",
      "body": [
        {
          "type": "questionnaire",
          "questionnaireId": "display_labels",
          "version": "2.3.0",
          "title": "display_labels",
          "hiddenValuePolicy": "retain",
          "fields": [
            {
              "id": "labelText",
              "label": "展签",
              "type": "text",
              "required": true,
              "minLength": 2,
              "maxLength": 16
            },
            {
              "id": "copies",
              "label": "copies",
              "type": "number",
              "required": true,
              "min": 0,
              "max": 10,
              "step": 1
            }
          ],
          "initialAnswers": {
            "labelText": "初稿牌",
            "copies": 5
          },
          "defaults": {
            "labelText": "重置牌",
            "copies": 1
          },
          "computed": {
            "doubledCopies": {
              "op": "mul",
