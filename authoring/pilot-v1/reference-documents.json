  {
    "id": "P08",
    "document": {
      "version": "iui/1",
      "body": [
        {
          "type": "questionnaire",
          "questionnaireId": "equipment_review",
          "version": "1.0.0",
          "title": "equipment_review",
          "hiddenValuePolicy": "retain",
          "fields": [
            {
              "id": "needsCable",
              "label": "needsCable",
              "type": "boolean",
              "required": true
            },
            {
              "id": "cableChecked",
              "label": "cableChecked",
              "type": "boolean",
              "required": true,
              "visibleWhen": {
                "op": "eq",
                "args": [
                  {
                    "$": "needsCable"
                  },
                  true
                ]
              }
            },
            {
              "id": "kits",
              "label": "kits",
              "type": "number",
              "required": true,
              "min": 0,
              "max": 5,
              "step": 1
            }
          ],
          "initialAnswers": {
            "needsCable": false,
            "cableChecked": null,
            "kits": 2
          },
          "defaults": {
            "needsCable": false,
            "cableChecked": null,
            "kits": 2
          },
          "computed": {
            "readyKits": {
              "op": "mul",
              "args": [
                {
                  "$": "kits"
                },
                2
              ]
            }
          },
          "sources": [
            {
              "title": "原创非医疗软件验收规则",
              "version": "1.0.0"
            }
          ],
          "action": "reviewEquipment",
          "submitLabel": "本地审阅",
          "resetLabel": "恢复问卷"
        }
      ]
    }
  }
]
