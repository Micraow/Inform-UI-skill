{
  "version": "iui/1",
  "state": {
    "enabled": false,
    "mode": 0
  },
  "body": [
    {
      "type": "row",
      "children": [
        {
          "type": "toggle",
          "label": "Enabled",
          "bind": "enabled"
        },
        {
          "type": "select",
          "label": "Mode",
