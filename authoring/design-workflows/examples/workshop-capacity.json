{
  "version": "iui/1",
  "state": {
    "attendees": 0
  },
  "computed": {
    "remaining": {
      "op": "sub",
      "args": [
        30,
        {
          "$": "attendees"
        }
      ]
    }
  },
  "body": [
    {
      "type": "form",
      "label": "Workshop capacity",
      "children": [
        {
          "type": "input",
          "label": "Attendees",
          "kind": "number",
          "bind": "attendees",
          "min": 0,
          "max": 30,
          "step": 1,
          "required": true
        },
        {
          "type": "row",
          "children": [
            {
              "type": "metric",
              "label": "Spaces remaining",
              "value": {
                "$": "remaining"
              },
              "unit": "spaces"
            },
            {
              "type": "text",
              "value": "Local planning only."
            }
          ]
        }
      ]
    }
  ]
}
